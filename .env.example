# r2mcp configuration
# Copy to .env and fill in your values

# Database connection string — choose one:
#
# Option A: Supabase (hosted pgvector, no Docker required)
#   Get from: Supabase Dashboard → Project Settings → Database → Connection string → Direct (not Pooler)
#   Note: use port 5432 (Direct), NOT port 6543 (Pooler) — setup requires a direct connection
# R2MCP_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
#
# Option B: Docker Compose (local dev)
# R2MCP_DATABASE_URL=postgresql://r2mcp:r2mcp@localhost:5432/r2mcp
#
R2MCP_DATABASE_URL=postgresql://r2mcp:r2mcp@localhost:5432/r2mcp

# OpenRouter API key — get yours at https://openrouter.ai/keys
# Used for text-embedding-3-small embeddings (~$0.02/1M tokens)
R2MCP_OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Enable OpenTelemetry tracing/metrics
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Edge classifier (SPEC-043) — ONLY used by `npm run edges:classify`, never by the MCP server hot path
ANTHROPIC_API_KEY=
R2MCP_EDGE_MAX_USD=1.00
