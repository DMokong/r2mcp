# r2mcp configuration
# Copy to .env and fill in your values

# Database connection string — choose one:
#
# Option A: Supabase (hosted pgvector, no Docker required)
#   Get from: Supabase Dashboard → Connect (top of page) → Session pooler
#   Use the SESSION pooler (port 5432) — IPv4-compatible on every tier and DDL-safe.
#   NOT the Transaction pooler (port 6543, no DDL) and NOT the Direct connection
#   unless your network has IPv6 (direct is IPv6-only without the paid IPv4 add-on).
# R2MCP_DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
#
# Option B: Docker Compose (local dev)
# R2MCP_DATABASE_URL=postgresql://r2mcp:r2mcp@localhost:5432/r2mcp
#
R2MCP_DATABASE_URL=postgresql://r2mcp:r2mcp@localhost:5432/r2mcp

# OpenRouter API key — get yours at https://openrouter.ai/keys
# Used for text-embedding-3-small embeddings (~$0.02/1M tokens).
# Also available as an opt-in provider for the classifier and wiki compiler;
# embeddings remain its default scope.
R2MCP_OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Enable OpenTelemetry tracing/metrics
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ──────────────────────────────────────────────────────────────────────────
# LLM provider configuration (SPEC-044)
# ──────────────────────────────────────────────────────────────────────────
# The MCP server itself never makes LLM calls. These vars only affect the
# standalone CLI drivers: `npm run edges:classify` and `npm run compile-wiki`.
#
# Provider selection precedence (highest to lowest):
#   1. --provider=<name> CLI flag
#   2. R2MCP_CLASSIFIER_PROVIDER env var
#   3. Auto-fallback: claude-code (if Claude Code is logged in) → anthropic
#      (if ANTHROPIC_API_KEY is set) → openrouter (if R2MCP_OPENROUTER_API_KEY
#      is set) → fatal error
#
# The fallback prefers `claude-code` so a Max-plan user pays $0/call.

# Force a provider for classifier and compile runs. One of:
#   claude-code | anthropic | openrouter
# Leave unset to use auto-fallback.
# R2MCP_CLASSIFIER_PROVIDER=claude-code

# Absolute path to the claude binary for the claude-code provider. Needed when
# the spawning process's PATH doesn't include it — common under launchd jobs
# and some MCP hosts. The spawn error names this variable when it's the fix.
# R2MCP_CLAUDE_BIN=/Users/you/.local/bin/claude

# Anthropic API key — only needed for --provider=anthropic.
# Optional otherwise; auto-fallback prefers claude-code (Max plan, $0/call).
ANTHROPIC_API_KEY=

# Edge classifier (SPEC-043) — cost cap for one classify run, in USD.
# CLI: `npm run edges:classify -- --max-cost=$X` overrides this.
R2MCP_EDGE_MAX_USD=1.00

# Wiki compile (SPEC-044) — cost cap for one compile run, in USD.
# CLI: `npm run compile-wiki -- --max-cost=$X` overrides this.
# Lint has no cost cap — it is SQL-only.
R2MCP_COMPILE_MAX_USD=1.00

# ──────────────────────────────────────────────────────────────────────────
# Live integration tests (CI-skipped by default)
# ──────────────────────────────────────────────────────────────────────────
# Cross-provider classification agreement test (D.AC6) — set to 1 to run.
# Costs ~$0.50–$1 per full run.
# R2MCP_RUN_CROSS_PROVIDER=1
# R2MCP_CROSS_PROVIDER_INCLUDE_CLAUDE_CODE=1

# SPEC-046 entity extractor — cost cap for one extract run, in USD.
# CLI: `npm run entities:extract -- --max-cost=$X` overrides this.
R2MCP_ENTITY_MAX_USD=1.00

# SPEC-046 entity extractor — number of top entities (by frequency) injected
# into the LLM prompt as known-entity context for alias-merging.
R2MCP_ENTITY_CONTEXT_TOP_N=100
