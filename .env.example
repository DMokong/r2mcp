# r2mcp configuration
# Copy to .env and fill in your values

# PostgreSQL connection string
# For Docker Compose (default): postgresql://r2mcp:r2mcp@localhost:5432/r2mcp
# For existing Postgres: postgresql://user:password@host:5432/dbname
R2MCP_DATABASE_URL=postgresql://r2mcp:r2mcp@localhost:5432/r2mcp

# OpenRouter API key — get yours at https://openrouter.ai/keys
# Used for text-embedding-3-small embeddings (~$0.02/1M tokens)
R2MCP_OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Enable OpenTelemetry tracing/metrics
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
